# AWS Rekognition Credentials for RaiSakshya Smart Attendance System
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
REKOGNITION_COLLECTION_ID=raisakshya-attendance

# Google SMTP Mail Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=RaiSakshya Attendance <your_email@gmail.com>

# EC2 Deployment & Network Configuration
EC2_PUBLIC_IP=3.110.208.141
HOST=0.0.0.0
PORT=5000
ALLOWED_ORIGINS=http://${EC2_PUBLIC_IP},http://${EC2_PUBLIC_IP}:5000,https://${EC2_PUBLIC_IP},https://${EC2_PUBLIC_IP}:5000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000
ALLOW_ALL_CORS=true

# SSL / HTTPS Configuration (Required for Browser Camera / MediaDevices Access)
ENABLE_HTTPS=true
SSL_CERT=cert.pem
SSL_KEY=key.pem
